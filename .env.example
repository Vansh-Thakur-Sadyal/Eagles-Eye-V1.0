# Example environment file for local development.
# Copy this to .env in the repo root if needed and fill in your local values.

SENTINEL_ENV=development
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_LOG_LEVEL=INFO
SENTINEL_STORAGE_DIR=./storage
SENTINEL_DATASET_DIR=./datasets
SENTINEL_CONFIG_DIR=./config
SENTINEL_DATABASE_URL=sqlite:///./storage/sentinel.db
SENTINEL_JWT_SECRET=replace-with-a-random-secret
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SENTINEL_LLM_PROVIDER=none
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=
SENTINEL_N8N_ENABLED=false
SENTINEL_N8N_BASE_URL=
SENTINEL_N8N_WEBHOOK_INCIDENT=
SENTINEL_N8N_WEBHOOK_UNATTENDED=
SENTINEL_N8N_WEBHOOK_DAILY_REPORT=
SENTINEL_N8N_WEBHOOK_SYSTEM_HEALTH=
