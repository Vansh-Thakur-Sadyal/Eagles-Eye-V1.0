# ============ SENTINEL AI — runtime configuration ============
# Nothing in the application is hardcoded; every value below is read at boot.

SENTINEL_ENV=development
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_LOG_LEVEL=INFO

# --- Storage (absolute or relative to project root) ---
SENTINEL_STORAGE_DIR=../storage
SENTINEL_DATASET_DIR=../datasets
SENTINEL_CONFIG_DIR=../config

# --- Database: SQLite by default, swap the URL for PostgreSQL in production ---
SENTINEL_DATABASE_URL=sqlite:///../storage/sentinel.db
# SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# --- Security ---
SENTINEL_JWT_SECRET=change-me-in-production
SENTINEL_JWT_TTL_MINUTES=720
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Compute / GPU -----------------------------------------------------------
# auto  -> use a discrete GPU when one is present, no prompt, fall back to CPU
# cuda  -> force GPU     cpu -> force CPU
SENTINEL_DEVICE_MODE=auto
SENTINEL_GPU_INDEX=0
# Fraction of VRAM the pipeline may reserve (0.0-1.0)
SENTINEL_GPU_MEMORY_FRACTION=0.85
SENTINEL_USE_HALF_PRECISION=true

# --- Models (all swappable without touching code) ---
SENTINEL_DETECTOR=yolo                       # yolo | locateanything | ensemble
SENTINEL_YOLO_WEIGHTS=yolo11m.pt
SENTINEL_YOLO_CONF=0.35
SENTINEL_YOLO_IOU=0.5
SENTINEL_YOLO_IMGSZ=640
# NVIDIA License: NON-COMMERCIAL (research / evaluation) use only - keep it
# disabled on any commercial deployment. Local path or Hugging Face id.
SENTINEL_LOCATEANYTHING_MODEL=nvidia/LocateAnything-3B
SENTINEL_LOCATEANYTHING_ENABLED=false
SENTINEL_LOCATEANYTHING_EVERY_N_FRAMES=120   # ~1 call / 10 s at 12 fps; each call briefly stalls the shared GPU
SENTINEL_LOCATEANYTHING_MODE=slow            # slow is reliable here; hybrid looped (docs/TRAINING_RESULTS.md)

# Where cameras are processed: auto | server | edge  (docs/EDGE_GPU.md)
SENTINEL_PROCESSING_PLACEMENT=auto
SENTINEL_EDGE_NODE_TIMEOUT_SECONDS=30
SENTINEL_REID_WEIGHTS=osnet_x1_0
SENTINEL_FACE_MODEL=buffalo_l
SENTINEL_TRACKER=bytetrack                   # bytetrack | deepsort

# --- Pipeline ---
SENTINEL_TARGET_FPS=12
SENTINEL_MAX_CONCURRENT_CAMERAS=8
SENTINEL_FRAME_QUEUE_SIZE=4
SENTINEL_SNAPSHOT_ON_INCIDENT=true

# --- LLM (agentic reasoning, incident narration, conversational search) ---
SENTINEL_LLM_PROVIDER=none                   # none | openai_compatible | ollama | anthropic | mistral
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=
SENTINEL_LLM_TIMEOUT=60

# --- Vector store / RAG ---
SENTINEL_VECTOR_BACKEND=chroma               # chroma | memory
SENTINEL_VECTOR_DIR=../storage/vectors
SENTINEL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Automation (n8n) ---
SENTINEL_N8N_ENABLED=false
SENTINEL_N8N_BASE_URL=
SENTINEL_N8N_WEBHOOK_INCIDENT=
SENTINEL_N8N_WEBHOOK_UNATTENDED=
SENTINEL_N8N_WEBHOOK_DAILY_REPORT=
SENTINEL_N8N_WEBHOOK_SYSTEM_HEALTH=

# --- Privacy ---
SENTINEL_PRIVACY_REDACTION=true              # blur non-subject faces by default
SENTINEL_PRIVACY_ANONYMOUS_BY_DEFAULT=true
SENTINEL_RETENTION_DAYS=30
SENTINEL_AUDIT_ALL_READS=true
